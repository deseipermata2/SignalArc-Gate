{
  "name": "signalarc-gate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:compatibility": "tsc -p tests/compatibility/tsconfig.json && node tests/compatibility/run.mjs",
    "pages:dev": "node scripts/dev-local.mjs",
    "build:functions": "wrangler pages functions build --outdir .wrangler/functions-build",
    "test:foundation": "tsc -p tsconfig.functions.json && node tests/foundation/run.mjs",
    "test:d1": "tsc -p tsconfig.functions.json && node tests/foundation/run.mjs --d1-only",
    "test:ui": "node tests/foundation/run.mjs --ui-only",
    "test": "npm run test:foundation && npm run test:compatibility && npm run test:sg03 && npm run test:sg05 && npm run test:sg06 && npm run test:sg07",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "test:sg03": "node tests/sg03/run.mjs",
    "test:sg05": "tsc -p tests/sg05/tsconfig.json && node tests/sg05/run.mjs",
    "test:sg06": "tsc -p tests/sg06/tsconfig.json && node tests/sg06/run.mjs",
    "test:sg07": "tsc -p tests/sg07/tsconfig.json && node tests/sg07/run.mjs"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.60.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/extensions": "2.29.0",
    "@x402/svm": "2.28.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "^4.3.3",
    "viem": "2.57.13",
    "wagmi": "3.7.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  }
}
